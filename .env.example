# ReFind AI - Example Environment Configuration
# Copy this file to .env if you want to override defaults locally.
# Never commit a real .env file containing secrets.

# Path to the SQLite database file (relative to project root)
REFIND_DB_PATH=data/refind_ai.db

# Directory for locally uploaded item photographs
REFIND_UPLOAD_DIR=uploads

# Pretrained Sentence-Transformers model identifier
REFIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional local Hugging Face cache directory
# HF_HOME=.cache/huggingface

# Hybrid Matching Weights (must sum to 1.0)
REFIND_WEIGHT_SEMANTIC=0.70
REFIND_WEIGHT_CATEGORY=0.15
REFIND_WEIGHT_LOCATION=0.10
REFIND_WEIGHT_DATE=0.05

# Minimum final score (0-100) to display as a recommended match
REFIND_MIN_MATCH_SCORE=35.0
